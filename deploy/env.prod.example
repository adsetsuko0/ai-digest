# Production settings. On the server this file is /opt/ai-digest/.env (chmod 600).
DOMAIN=your-name.duckdns.org
AI_DIGEST_VERSION=0.9.0-rc1

# generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
SECRET_KEY=

# optional, the defaults are the fake providers (no API key needed)
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_DAILY_TOKEN_BUDGET=200000